# Copy to .env at repo root for local backend (optional — SQLite used if DATABASE_URL unset)

# PostgreSQL (Render: Internal Database URL, or local Postgres)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# JWT signing — MUST be a long random string in production (Render can generate this)
# SECRET_KEY=

# Production: list every frontend origin that may call the API (comma-separated, no trailing /)
# Example: https://my-app.vercel.app
# Local dev: leave unset — localhost is always allowed via regex.
# CORS_ORIGINS=https://your-app.vercel.app

# Optional: allow any Vercel preview (https://*.vercel.app). Use only if you need branch previews.
# Default in code is OFF — prefer explicit CORS_ORIGINS for production.
# CORS_ALLOW_VERCEL=true
